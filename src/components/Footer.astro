---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container inner">
    <p>© {year} Bao Thanh Quach</p>
    <p class="mono">baothanhquach.dev</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-obsidian); border-top: 1px solid var(--color-basalt); }
  .inner { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 24px 0; }
  p { margin: 0; font-size: 14px; color: var(--color-fog); }
</style>
