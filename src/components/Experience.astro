---
import { experience } from "../data/experience";
---
<section id="experience" class="section" aria-labelledby="experience-heading">
  <div class="container">
    <h2 id="experience-heading">Experience</h2>
    <div class="panel log">
      <div class="panel-head"><span>experience.log</span><span>{experience.length} entries</span></div>
      <ul class="jobs">
        {experience.map((job) => (
          <li class="job">
            <p class="dates mono tabular"><span class:list={["dot", { on: job.end === "Present" }]} aria-hidden="true"></span>{job.start} – {job.end}</p>
            <div>
              <h3>{job.company} <span class="role">{job.role}</span></h3>
              <p class="location">{job.location}</p>
              <ul class="points">
                {job.points.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .log { margin-top: 32px; }
  .jobs { list-style: none; margin: 0; padding: 0; }
  .job {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 24px;
    padding: 24px 20px;
    border-bottom: 1px solid var(--color-iron);
  }
  .job:last-child { border-bottom: 0; }
  .dates { margin: 0; padding-top: 3px; font-size: 14px; color: var(--color-fog); }
  h3 { font-size: 18px; margin-bottom: 2px; }
  .role { font-family: var(--font-text); font-size: 15px; font-weight: 400; letter-spacing: var(--tracking-body); color: var(--color-silver); margin-left: 6px; }
  .location { margin-bottom: 10px; font-size: 14px; color: var(--color-fog); }
  .points { margin: 0; padding-left: 1.1rem; font-size: 15px; color: var(--color-silver); }
  .points li { margin-bottom: 4px; max-width: var(--measure); }
  .points li::marker { color: var(--color-steel); }
  @media (max-width: 45rem) {
    .job { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
