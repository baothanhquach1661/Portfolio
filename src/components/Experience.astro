---
import { experience } from "../data/experience";
---
<section id="experience" class="experience" aria-labelledby="experience-heading">
  <h2 id="experience-heading">Experience</h2>
  <ul class="jobs">
    {experience.map((job) => (
      <li class="job">
        <p class="dates tabular">{job.start} – {job.end}</p>
        <div class="entry">
          <h3>{job.company}<span class="location">{job.location}</span></h3>
          <p class="role">{job.role}</p>
          <ul class="points">
            {job.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .experience { max-width: 64rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
  .jobs { list-style: none; margin: 0; padding: 0; border-top: 3px double var(--foil); }
  .job {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    border-bottom: 1px solid var(--rule);
  }
  .dates {
    margin: 0;
    padding: 1.6rem 1.5rem 1.5rem 0;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }
  .entry {
    padding: 1.5rem 0 1.5rem 1.75rem;
    border-left: 3px double var(--margin-red);
  }
  h3 { font-size: 1.2rem; margin-bottom: 0.15rem; }
  .location {
    margin-left: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--ink-muted);
  }
  .role { margin-bottom: 0.6rem; color: var(--ink-muted); }
  .points { margin: 0; padding-left: 1.25rem; }
  .points li { margin-bottom: 0.35rem; max-width: var(--measure); }
  @media (max-width: 40rem) {
    .job { grid-template-columns: 1fr; }
    .dates { padding: 1.25rem 0 0; }
    .entry { padding: 0.5rem 0 1.25rem 1.25rem; }
  }
</style>
