---
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---
<section id="projects" class="section" aria-labelledby="projects-heading">
  <div class="container">
    <h2 id="projects-heading">Projects</h2>
    <div class="grid">
      {projects.map((project, i) => (
        <article class:list={["card", { featured: i === 0 }]}>
          <p class="label status"><span class:list={["dot", { on: project.data.status.toLowerCase().startsWith("live") }]} aria-hidden="true"></span>{project.data.status}</p>
          <h3><a href={`/projects/${project.id}`}>{project.data.title}</a></h3>
          <p class="tagline">{project.data.tagline}</p>
          <p class="summary">{project.data.summary}</p>
          <dl class="facts mono tabular">
            {project.data.facts.map((fact) => (
              <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
            ))}
          </dl>
          <ul class="tags" aria-label="Stack">
            {project.data.stack.map((item) => <li class="tag">{item}</li>)}
          </ul>
          <a class="more" href={`/projects/${project.id}`}>Read the case study →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 16px; margin-top: 32px; }
  @media (max-width: 26rem) { .grid { grid-template-columns: 1fr; } }
  .card {
    display: flex;
    flex-direction: column;
    padding: var(--card-padding);
    background: var(--color-graphite);
    border: 1px solid var(--color-basalt);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-subtle);
  }
  .card.featured { border-color: var(--color-moss-border); }
  .status { margin-bottom: 14px; }
  h3 { margin-bottom: 4px; }
  h3 a { color: var(--color-chalk); }
  .tagline { margin-bottom: 12px; font-size: 14px; color: var(--color-fog); }
  .summary { font-size: 15px; color: var(--color-silver); }
  .facts { margin: 4px 0 20px; font-size: 14px; }
  .facts div { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--color-iron); }
  .facts div:first-child { border-top: 1px solid var(--color-iron); }
  dt { color: var(--color-fog); }
  dd { margin: 0; color: var(--color-ash); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0 0 20px; padding: 0; }
  .more { margin-top: auto; font-size: 15px; font-weight: 500; }
</style>
