---
const links = [
  { href: "/#projects", label: "Projects" },
  { href: "/#experience", label: "Experience" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="site-header">
  <a class="nameplate" href="/">Bao Thanh Quach</a>
  <nav aria-label="Main">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>

<style>
  .site-header {
    max-width: 64rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .nameplate {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--ink-strong);
    text-decoration: none;
  }
  .nameplate:hover {
    color: var(--ledger);
  }
  nav {
    display: flex;
    gap: 1.5rem;
  }
  nav a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ledger);
    text-decoration: underline;
  }
</style>
