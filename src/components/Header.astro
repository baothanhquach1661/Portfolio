---
const links = [
  { href: "/#projects", label: "Projects" },
  { href: "/#experience", label: "Experience" },
  { href: "/#contact", label: "Contact" },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/"><span class="mark mono" aria-hidden="true">&lt;/&gt;</span>Bao Thanh Quach</a>
    <nav aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="nav-btn" href="/Bao_Thanh_Quach_Resume.pdf">Resume</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-carbon);
    border-bottom: 1px solid var(--color-basalt);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0;
    color: var(--color-chalk);
    text-decoration: none;
  }
  .mark {
    display: inline-block;
    margin-right: 10px;
    padding: 1px 6px;
    font-size: 13px;
    color: var(--color-lilac-accent);
    border: 1px solid var(--color-plum-edge);
    border-radius: var(--radius-sm);
  }
  nav { display: flex; gap: 28px; }
  nav a { font-size: 14px; font-weight: 500; color: var(--color-ash); }
  nav a:hover { color: var(--color-chalk); text-decoration: none; }
  .nav-btn {
    justify-self: end;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ash);
    background: var(--color-obsidian);
    border: 1px solid var(--color-basalt);
    border-radius: var(--radius-md);
  }
  .nav-btn:hover { border-color: var(--color-pewter); text-decoration: none; }
  @media (max-width: 40rem) {
    .bar { grid-template-columns: 1fr auto; }
    nav { grid-column: 1 / -1; grid-row: 2; gap: 20px; }
  }
</style>
