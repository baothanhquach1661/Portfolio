---
const tools = [
  "C#", "ASP.NET Core", "EF Core", "SQL Server", "PostgreSQL",
  "Python", "GitHub Actions", "Docker", "Microsoft Azure", "Shopify",
];
---
<section class="section" aria-labelledby="stack-heading">
  <div class="container">
    <h2 id="stack-heading">Tools I work with</h2>
    <ul class="grid">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    border-top: 1px solid var(--color-basalt);
    border-left: 1px solid var(--color-basalt);
  }
  li {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 88px;
    padding: 16px;
    border-right: 1px solid var(--color-basalt);
    border-bottom: 1px solid var(--color-basalt);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-silver);
    text-align: center;
  }
  @media (max-width: 48rem) { .grid { grid-template-columns: repeat(2, 1fr); } li { min-height: 64px; font-size: 16px; } }
</style>
